 # n8n Settings
DOMAIN_NAME=yourdomain.com
SUBDOMAIN=n8n
GENERIC_TIMEZONE=America/Chicago # Pick your timezone
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_SECURE_COOKIE=false
NODE_ENV=production
N8N_PUSH_BACKEND=websocket



# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
DB_POSTGRESDB_HOST=n8n-postgres
DB_POSTGRESDB_PORT=5432
POSTGRES_PASSWORD=somethingverysecure
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=somethingverysecure
